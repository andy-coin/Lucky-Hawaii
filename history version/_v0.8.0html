            { id: 14, label: 'ㄤ',    rhymes: new Set(['ㄤ', 'ㄧㄤ', 'ㄨㄤ']) },
            { id: 15, label: 'ㄨㄥ',  rhymes: new Set(['ㄨㄥ', 'ㄩㄥ']) },
        ];
        // 快速查表：韻母 → 家族 id
        const RHYME_TO_FAMILY = {};
        RHYME_FAMILIES.forEach(f => f.rhymes.forEach(r => RHYME_TO_FAMILY[r] = f.id));

        // 拼音韻母 → 注音韻母對照（附件一 §I）
        // 翻譯後走注音搜尋流程（含借韻展開）
        const PINYIN_RHYME_MAP = {
            'i': 'ㄧ', 'y': 'ㄧ',
            'u': 'ㄨ', 'w': 'ㄨ',
            'v': 'ㄩ',
            'a': 'ㄚ', 'o': 'ㄛ', 'e': 'ㄜ',
