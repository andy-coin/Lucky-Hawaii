            'ㄥ1':'-｜-｜-',
            'ㄦ2':'而｜兒｜-',
            'ㄦ3':'耳｜爾洱餌｜-',
            'ㄦ4':'二｜貳｜-',
        }
        // ==================== 字庫解析引擎 ====================
        let chineseDict = {};   // char → [baseZhuyin, ...] — 搜尋用（向下相容）
        let charInfo = {};      // char → [{zhuyin, tone, tier}, ...] — 聲調/分級資訊

        function buildIndex() {
            chineseDict = {};
            charInfo = {};

            for (const [key, value] of Object.entries(rhymeDict)) {
                const tone = parseInt(key.slice(-1));
                const baseZhuyin = key.slice(0, -1);

                const parts = value.split('｜');
                const tiers = ['common', 'normal', 'rare'];

                parts.forEach((part, idx) => {
                    if (!part || part.trim() === '—' || part.trim() === '-') return;
                    const tier = tiers[idx] || 'rare';
                    const chars = [...part.trim()].filter(c => c.trim() && c !== '—' && c !== '-');

                    chars.forEach(char => {
                        // chineseDict（搜尋相容）
                        if (!chineseDict[char]) chineseDict[char] = [];
                        if (!chineseDict[char].includes(baseZhuyin)) {
                            chineseDict[char].push(baseZhuyin);
                        }
                        // charInfo（聲調 + 分級）
                        if (!charInfo[char]) charInfo[char] = [];
                        charInfo[char].push({ zhuyin: baseZhuyin, tone, tier });
                    });
                });
            }

            console.log(`[buildIndex] ${Object.keys(chineseDict).length} 字, ${Object.keys(rhymeDict).length} 組`);
        }

        // ==================== 標記系統（直接修改字庫）====================

        let dictOverrides = {}; // 記錄被使用者修改過的 rhymeDict key

        function loadDictOverrides() {
            try {
                const saved = localStorage.getItem('dictOverrides_v076');
                if (saved) {
                    dictOverrides = JSON.parse(saved);
                    for (const [key, val] of Object.entries(dictOverrides)) {
                        rhymeDict[key] = val;
                    }
                }
            } catch(e) { dictOverrides = {}; }
        }

        function saveDictOverrides() {
            try { localStorage.setItem('dictOverrides_v076', JSON.stringify(dictOverrides)); } catch(e) {}
        }

        // 取得字的分級（直接從 charInfo 讀取，永遠是最新狀態）
        function getCharMark(char, zhuyin) {
            const infos = charInfo[char];
            if (!infos || infos.length === 0) return 'normal';
            if (zhuyin) {
                const match = infos.find(i => i.zhuyin === zhuyin);
                if (match) return match.tier;
            }
            return infos[0].tier;
        }

        // 在 rhymeDict 中移動字的分級位置
        function moveCharTier(char, dictKey, newTier) {
            const entry = rhymeDict[dictKey];
            if (!entry) return;

            const parts = entry.split('｜');
            while (parts.length < 3) parts.push('—');

            // 從所有區域移除該字
            for (let i = 0; i < parts.length; i++) {
                const chars = [...parts[i]].filter(c => c !== '—' && c !== '-' && c.trim());
                const idx = chars.indexOf(char);
                if (idx !== -1) {
                    chars.splice(idx, 1);
                    parts[i] = chars.length > 0 ? chars.join('') : '—';
                }
            }

            // 加入目標區域
            const tierIdx = { common: 0, normal: 1, rare: 2 }[newTier];
            if (parts[tierIdx] === '—' || parts[tierIdx] === '-') {
                parts[tierIdx] = char;
            } else {
                parts[tierIdx] += char;
            }

            // 更新 rhymeDict
            rhymeDict[dictKey] = parts.join('｜');
            dictOverrides[dictKey] = rhymeDict[dictKey];
            saveDictOverrides();

            // 更新 charInfo（就地修改，不需 rebuild）
            const baseZhuyin = dictKey.slice(0, -1);
            const tone = parseInt(dictKey.slice(-1));
            const infos = charInfo[char];
            if (infos) {
                const match = infos.find(i => i.zhuyin === baseZhuyin && i.tone === tone);
                if (match) match.tier = newTier;
            }
        }

        // 循環切換：常用 → 一般 → 冷僻 → 常用
        function cycleCharMark(char, dictKey) {
            const baseZhuyin = dictKey.slice(0, -1);
            const current = getCharMark(char, baseZhuyin);
            let newTier;
            if (current === 'common') newTier = 'normal';
            else if (current === 'normal') newTier = 'rare';
            else newTier = 'common';

            moveCharTier(char, dictKey, newTier);
        }

        // ==================== 注音優先核心函數 ====================
        
        // 從注音字串提取聲母
        function getZhuyinInitial(zhuyin) {
            if (!zhuyin || zhuyin.length === 0) return '';
            if (zhuyinInitialSet.has(zhuyin[0])) {
                return zhuyin[0];
            }
            return ''; // 無聲母（如 ㄢ, ㄧ 等）
        }
        
        // 從注音字串提取韻母
        function getZhuyinRhyme(zhuyin) {
            if (!zhuyin || zhuyin.length === 0) return '';
            if (zhuyinInitialSet.has(zhuyin[0])) {
                const rhyme = zhuyin.substring(1);
                return rhyme || zhuyin; // 純聲母（如 ㄓ=知）時回傳整個
            }
            return zhuyin; // 整個都是韻母
        }
        
                function pinyinToZhuyinGroups(pinyin) {
            pinyin = pinyin.toLowerCase().trim();
            if (!pinyin) return [];

            // 1. 完整音節精確匹配
            if (fullPinyinToZhuyin[pinyin]) {
                // 直接查到（如 ban→[ㄅㄢ], nu→[ㄋㄨ,ㄋㄩ]）
                const results = [];
                const seenRhymes = new Set();
                for (const zy of fullPinyinToZhuyin[pinyin]) {
                    const rhyme = getZhuyinRhyme(zy);
                    if (!seenRhymes.has(rhyme)) {
                        seenRhymes.add(rhyme);
                        results.push({ zhuyin: zy, rhyme: rhyme, type: 'exact' });
                    }
                }
                return results;
            }

            // 2. 純拼音聲母（b, zh, sh...）
            if (pinyinInitialToZhuyin[pinyin]) {
                return [{ zhuyin: pinyinInitialToZhuyin[pinyin], type: 'initial' }];
            }

            // 3. 韻尾搜尋：找所有拼音結尾匹配的音節，收集不重複的注音韻母
            const seenRhymes = new Set();
            const results = [];
            for (const [py, zhuyinList] of Object.entries(fullPinyinToZhuyin)) {
                if (py.endsWith(pinyin) && py !== pinyin) {
                    for (const zy of zhuyinList) {
                        const rhyme = getZhuyinRhyme(zy);
                        if (!seenRhymes.has(rhyme)) {
                            seenRhymes.add(rhyme);
                            results.push({ zhuyin: rhyme, rhyme: rhyme, type: 'rhyme' });
                        }
                    }
                }
            }
            return results;
        }

        // 向下相容：單一結果版本（供顯示等用途）
        function pinyinToZhuyin(pinyin) {
            const groups = pinyinToZhuyinGroups(pinyin);
            if (groups.length === 0) return '';
            return groups[0].zhuyin;
        }

        // 注音 → 拼音（用於顯示）— 使用完整查找表
        function zhuyinToPinyin(zhuyin) {
            if (!zhuyin) return '';
            // 直接查完整音節
            if (fullZhuyinToPinyin[zhuyin]) return fullZhuyinToPinyin[zhuyin];
            // 拆成聲母+韻母查找
            const initial = getZhuyinInitial(zhuyin);
            const rhyme = getZhuyinRhyme(zhuyin);
            if (initial && initial !== zhuyin) {
                const fullKey = initial + (rhyme !== zhuyin ? rhyme : '');
                if (fullZhuyinToPinyin[fullKey]) return fullZhuyinToPinyin[fullKey];
            }
            // 純聲母
            if (initial && rhyme === zhuyin) {
                if (fullZhuyinToPinyin[initial]) return fullZhuyinToPinyin[initial];
            }
            return zhuyin; // fallback
        }

        function isPinyinInitial(input) {
            return !!pinyinInitialToZhuyin[input.toLowerCase()];
        }
        
        // 判斷輸入是否為注音聲母
        function isZhuyinInitial(input) {
            return zhuyinInitialSet.has(input);
        }
        
        // 主搜尋邏輯（注音優先）
        function searchRhyme(input) {
            if (!input) { searchedTerms = []; return []; }
            input = input.trim();
            lastSearchInput = input;
            const isBopomofo = /[ㄅ-ㄩ]/.test(input);
            lastSearchType = isBopomofo ? 'bopomofo' : 'pinyin';
            
            const queries = input.split(/\s+/);
            const allResults = [];
            const seenChars = new Set();
            searchedTerms = [];
            let gOff = 0;

            // === 輔助：從字典匹配韻母列表 ===
            function collectByRhymes(rhymeList, initials, groupIdx) {
                const rhymeSet = new Set(rhymeList);
                for (let char in chineseDict) {
                    if (seenChars.has(char)) continue;
                    for (let zy of chineseDict[char]) {
                        const rh = getZhuyinRhyme(zy);
                        const ini = getZhuyinInitial(zy);
                        if (rhymeSet.has(rh) && (!initials || initials.has(ini))) {
                            allResults.push({
                                char, zhuyin: zy, pinyin: zhuyinToPinyin(zy),
                                zhuyinRhyme: rh, zhuyinInitial: ini,
                                rhymeIndex: groupIdx
                            });
                            seenChars.add(char);
                            break;
                        }
                    }
                }
            }
            
            // === 韻母搜尋（借韻展開，全部歸為同一組）===
            // 同聲韻並列時由 displayResults 按子音重新分組
            function expandBorrow(targetRhyme, queryLabel) {
                const borrowed = BORROW_MAP[targetRhyme];
                const allRhymes = borrowed || [targetRhyme];
                const idx = gOff;
                searchedTerms.push({
                    original: queryLabel, zhuyin: targetRhyme,
                    isInitial: false, isRhymeSearch: true, index: idx
                });
                collectByRhymes(allRhymes, null, idx);
                gOff++;
            }
            
            // === 子音搜尋（按韻母家族分組上色）===
            function searchByInitial(targetInitial, queryLabel) {
                const familyGroups = {};
                for (let char in chineseDict) {
                    if (seenChars.has(char)) continue;
                    for (let zy of chineseDict[char]) {
                        if (getZhuyinInitial(zy) === targetInitial) {
                            const rh = getZhuyinRhyme(zy);
                            const famId = RHYME_TO_FAMILY[rh] !== undefined ? RHYME_TO_FAMILY[rh] : -1;
                            if (!familyGroups[famId]) familyGroups[famId] = [];
                            familyGroups[famId].push({
                                char, zhuyin: zy, pinyin: zhuyinToPinyin(zy),
                                zhuyinRhyme: rh, zhuyinInitial: targetInitial
                            });
                            seenChars.add(char);
                            break;
                        }
                    }
                }
                const sortedFamIds = Object.keys(familyGroups).sort((a, b) => parseInt(a) - parseInt(b));
                sortedFamIds.forEach(famId => {
                    const fam = RHYME_FAMILIES[parseInt(famId)];
                    const idx = gOff;
                    // 收集本組實際出現的韻母名稱
                    const rhymesInGroup = [...new Set(familyGroups[famId].map(it => it.zhuyinRhyme))];
                    searchedTerms.push({
                        original: queryLabel,
                        zhuyin: fam ? fam.label : '/',
                        rhymeMembers: rhymesInGroup,
                        isInitial: true, isRhymeSearch: false, index: idx
                    });
                    familyGroups[famId].forEach(item => {
                        item.rhymeIndex = idx;
                        allResults.push(item);
                    });
                    gOff++;
                });
            }
            
            // === 子音+介音搜尋（如 bi/bu/ju）===
            function searchByInitialMedial(targetInitial, medial, queryLabel) {
                const familyGroups = {};
                for (let char in chineseDict) {
                    if (seenChars.has(char)) continue;
                    for (let zy of chineseDict[char]) {
                        const ini = getZhuyinInitial(zy);
                        const rh = getZhuyinRhyme(zy);
                        if (ini === targetInitial && (rh === medial || rh.startsWith(medial))) {
                            const famId = RHYME_TO_FAMILY[rh] !== undefined ? RHYME_TO_FAMILY[rh] : -1;
                            if (!familyGroups[famId]) familyGroups[famId] = [];
                            familyGroups[famId].push({
                                char, zhuyin: zy, pinyin: zhuyinToPinyin(zy),
                                zhuyinRhyme: rh, zhuyinInitial: ini
                            });
                            seenChars.add(char);
                            break;
                        }
                    }
                }
                const sortedFamIds = Object.keys(familyGroups).sort((a, b) => parseInt(a) - parseInt(b));
                sortedFamIds.forEach(famId => {
                    const fam = RHYME_FAMILIES[parseInt(famId)];
                    const idx = gOff;
                    const rhymesInGroup = [...new Set(familyGroups[famId].map(it => it.zhuyinRhyme))];
                    searchedTerms.push({
                        original: queryLabel,
                        zhuyin: fam ? fam.label : '/',
                        rhymeMembers: rhymesInGroup,
                        isInitial: true, isRhymeSearch: false, index: idx
                    });
                    familyGroups[famId].forEach(item => {
                        item.rhymeIndex = idx;
                        allResults.push(item);
                    });
                    gOff++;
                });
            }
            
            // === PINYIN_SPECIAL 分組匹配（韻母組分色）===
            function matchSpecial(groups) {
                groups.forEach((sg) => {
                    const idx = gOff;
                    searchedTerms.push({
                        original: sg.label, zhuyin: sg.label,
                        isInitial: false, isRhymeSearch: false, index: idx
                    });
                    const rhymeSet = new Set(sg.rhymes);
                    for (let char in chineseDict) {
                        if (seenChars.has(char)) continue;
                        for (let zy of chineseDict[char]) {
                            const rh = getZhuyinRhyme(zy);
                            const ini = getZhuyinInitial(zy);
                            if (rhymeSet.has(rh) && (!sg.initials || sg.initials.has(ini))) {
                                allResults.push({
                                    char, zhuyin: zy, pinyin: zhuyinToPinyin(zy),
                                    zhuyinRhyme: rh, zhuyinInitial: ini,
                                    rhymeIndex: idx
                                });
                                seenChars.add(char);
                                break;
                            }
                        }
                    }
                    gOff++;
                });
            }
            
            // === uo 特殊處理（*ㄨㄛ + ㄅㄛ/ㄆㄛ/ㄇㄛ，按子音分組）===
            function matchUo() {
                const idx = gOff;
                const bpmfSet = new Set(['ㄅ','ㄆ','ㄇ']);
                searchedTerms.push({
                    original: 'uo', zhuyin: 'ㄨㄛ',
                    isInitial: false, isRhymeSearch: true, index: idx
                });
                for (let char in chineseDict) {
                    if (seenChars.has(char)) continue;
                    for (let zy of chineseDict[char]) {
                        const rh = getZhuyinRhyme(zy);
                        const ini = getZhuyinInitial(zy);
                        if (rh === 'ㄨㄛ' || (rh === 'ㄛ' && bpmfSet.has(ini))) {
                            allResults.push({
                                char, zhuyin: zy, pinyin: zhuyinToPinyin(zy),
                                zhuyinRhyme: rh, zhuyinInitial: ini,
                                rhymeIndex: idx
                            });
                            seenChars.add(char);
                            break;
                        }
                    }
                }
                gOff++;
            }

            // === 主流程 ===
            queries.forEach((query) => {
                const queryIsBopomofo = /[ㄅ-ㄩ]/.test(query);
                
                if (queryIsBopomofo) {
                    const zy = query;
                    const isSingleInitial = zy.length === 1 && zhuyinInitialSet.has(zy);
                    
                    if (isSingleInitial) {
                        searchByInitial(zy, query);
                    } else {
                        let targetRhyme = zy;
                        if (zy.length > 1 && zhuyinInitialSet.has(zy[0])) {
                            targetRhyme = zy.substring(1);
                        }
                        expandBorrow(targetRhyme, query);
                    }
                } else {
                    const py = query.toLowerCase();
                    
                    // 1. uo 特殊處理
                    if (py === 'uo') { matchUo(); return; }
                    
                    // 2. 拼音特殊搜尋（ng, uan, un）
                    if (PINYIN_SPECIAL[py]) {
                        matchSpecial(PINYIN_SPECIAL[py]);
                        return;
                    }
                    
                    // 3. 拼音韻母對照表 → 轉注音 → 走借韻
                    if (PINYIN_RHYME_MAP[py]) {
                        expandBorrow(PINYIN_RHYME_MAP[py], query);
                        return;
                    }
                    
                    // 4. 完整拼音音節
                    const groups = pinyinToZhuyinGroups(py);
                    if (groups.length === 0) return;
                    
                    const isInitialSearch = groups.length === 1 && groups[0].type === 'initial';
                    
                    if (isInitialSearch) {
                        searchByInitial(groups[0].zhuyin, query);
                    } else if (groups.length === 1) {
                        const g = groups[0];
                        const gInitial = getZhuyinInitial(g.zhuyin);
                        const gRhyme = g.rhyme || getZhuyinRhyme(g.zhuyin);
                        const medials = new Set(['ㄧ', 'ㄨ', 'ㄩ']);
                        if (gInitial && medials.has(gRhyme) && g.type === 'exact') {
                            searchByInitialMedial(gInitial, gRhyme, query);
                        } else {
                            expandBorrow(gRhyme, query);
                        }
                    } else {
                        groups.forEach((g) => {
                            const targetRhyme = g.rhyme || g.zhuyin;
                            expandBorrow(targetRhyme, query);
                        });
                    }
                }
            });
            
            return allResults;
        }


        // 全局狀態
        let currentMode = 'common';
        let selectedChars = new Set();
        let recentClicks = [];
        let lastSearchInput = '';
        let lastSearchType = 'pinyin';
        let searchedTerms = [];
        let hasCustomTextColor = false;

        // 創建字卡 (highlightTarget: 'initial'=標記子音, 'rhyme'=標記母音, null=自動)
        function createCharCard(item, showPinyin, highlightTarget) {
            const isSelected = selectedChars.has(item.char) ? 'selected' : '';
            const highlightSearch = document.getElementById('highlightSearch').checked;
            const mark = getCharMark(item.char, item.zhuyin);
            const customColorClass = hasCustomTextColor ? 'custom-color' : '';
            
            let displayText = '';
            
            if (showPinyin) {
                const showAsZhuyin = lastSearchType === 'bopomofo';
                const zhuyinInit = item.zhuyinInitial || '';
                const zhuyinRhy = item.zhuyinRhyme || '';
                // 如果韻母就是整個注音（純聲母字如 ㄓ），不拆分
                const isInitialOnly = zhuyinInit && zhuyinRhy === item.zhuyin;
                
                if (showAsZhuyin) {
                    // === 注音顯示模式 ===
                    const dispInit = zhuyinInit;
                    const dispRhyme = isInitialOnly ? '' : zhuyinRhy;
                    
                    if (highlightSearch) {
                        const searchTerm = searchedTerms.find(s => s.index === item.rhymeIndex) || searchedTerms[0];
                        const colorIdx = item._displayIndex !== undefined ? item._displayIndex : item.rhymeIndex;
                        const colorClass = `search-highlight-${(colorIdx % 5) + 1}`;
                        // highlightTarget 優先，否則用 searchTerm.isInitial
                        const hlInit = highlightTarget ? (highlightTarget === 'initial') : (searchTerm && searchTerm.isInitial);
                        if (hlInit) {
                            displayText = `<span class="${colorClass}">${dispInit}</span>${dispRhyme}`;
                        } else {
                            displayText = `${dispInit}<span class="${colorClass}">${dispRhyme || dispInit}</span>`;
                        }
                    } else {
                        displayText = isInitialOnly ? zhuyinInit : (zhuyinInit + zhuyinRhy);
                    }
                } else {
                    // === 拼音顯示模式 ===
                    const pinyinFull = item.pinyin || zhuyinToPinyin(item.zhuyin);
                    let pInit = '';
                    let pRhyme = pinyinFull;
                    for (const pi of pinyinInitials) {
                        if (pinyinFull.startsWith(pi) && pinyinFull.length > pi.length) {
                            pInit = pi;
                            pRhyme = pinyinFull.substring(pi.length);
                            break;
                        }
                    }
                    
                    if (highlightSearch) {
                        const searchTerm = searchedTerms.find(s => s.index === item.rhymeIndex) || searchedTerms[0];
                        const colorIdx = item._displayIndex !== undefined ? item._displayIndex : item.rhymeIndex;
                        const colorClass = `search-highlight-${(colorIdx % 5) + 1}`;
                        const hlInit = highlightTarget ? (highlightTarget === 'initial') : (searchTerm && searchTerm.isInitial);
                        if (hlInit) {
                            displayText = `<span class="${colorClass}">${pInit}</span>${pRhyme}`;
                        } else {
                            displayText = `${pInit}<span class="${colorClass}">${pRhyme}</span>`;
                        }
                    } else {
                        displayText = pinyinFull;
                    }
                }
            }
            
            // 聲調符號
            if (showPinyin && displayText) {
                const toneMarks = { 1: '', 2: 'ˊ', 3: 'ˇ', 4: 'ˋ', 5: '˙' };
                const toneMark = toneMarks[item.tone] || '';
                if (toneMark) {
                    displayText += `<span class="tone-mark">${toneMark}</span>`;
                }
            }

            // 標記徽章（帶 dictKey 供直接修改字庫）
            const dictKey = (item.zhuyin || '') + (item.tone || 0);
            let badgeHTML = '';
            const badgeAttr = `data-char="${item.char}" data-key="${dictKey}"`;
            if (mark === 'common') {
                badgeHTML = `<span class="mark-badge common" ${badgeAttr} onclick="handleBadgeClick(event)">常用</span>`;
            } else if (mark === 'rare') {
                badgeHTML = `<span class="mark-badge rare" ${badgeAttr} onclick="handleBadgeClick(event)">冷僻</span>`;
            } else {
                badgeHTML = `<span class="mark-badge normal" ${badgeAttr} onclick="handleBadgeClick(event)">一般</span>`;
            }
            
            return `
                <div class="char-card ${isSelected}" data-char="${item.char}" data-key="${dictKey}">
                    <div class="char-main ${customColorClass}">${item.char}</div>
                    ${showPinyin ? `<div class="char-pinyin">${displayText}</div>` : ''}
                    ${badgeHTML}
                </div>
            `;
        }

        // 延遲重排系統
        let reorderTimer = null;
        const REORDER_DELAY = 3000; // 3秒

        // 處理徽章點擊（阻止冒泡，不觸發選取）
        function handleBadgeClick(event) {
            event.stopPropagation();
            event.preventDefault();
            const badge = event.target;
            const char = badge.dataset.char;
            const dictKey = badge.dataset.key;
            if (!char || !dictKey) return;

            cycleCharMark(char, dictKey);

            // 就地更新徽章外觀（不重排）
            const baseZhuyin = dictKey.slice(0, -1);
            const newMark = getCharMark(char, baseZhuyin);
            
            if (newMark === 'common') {
                badge.className = 'mark-badge common';
                badge.textContent = '常用';
            } else if (newMark === 'rare') {
                badge.className = 'mark-badge rare';
                badge.textContent = '冷僻';
            } else {
                badge.className = 'mark-badge normal';
                badge.textContent = '一般';
            }
            
            // 重置/延長 3 秒計時器（共用同一個計時器 = 同區間內累積）
            if (reorderTimer) {
                clearTimeout(reorderTimer);
            }
            reorderTimer = setTimeout(() => {
                reorderTimer = null;
                // 時間到：完整重新渲染（含排序）
                const currentInput = document.getElementById('searchInput').value;
                if (currentInput) {
                    const results = searchRhyme(currentInput);
                    // 加入淡入動畫
                    const container = document.getElementById('resultsContainer');
                    container.style.opacity = '0.001';
                    container.style.transition = 'opacity 0.3s ease';
                    setTimeout(() => {
                        displayResults(results);
                        container.style.opacity = '1';
                    }, 500);
                }
            }, REORDER_DELAY);
        }

        // 切換選中狀態
        function toggleSelection(char, cardElement) {
            if (selectedChars.has(char)) {
                selectedChars.delete(char);
                cardElement.classList.remove('selected');
            } else {
                selectedChars.add(char);
                cardElement.classList.add('selected');
                addToRecentClicks(char);
            }
            updateBatchCount();
        }

        // 批量標記（含延遲重渲染）
        function batchMark(action) {
            if (selectedChars.size === 0) return;

            const cards = document.querySelectorAll('.char-card.selected');
            const processed = new Set();
            const newTier = action === 'clear' ? 'normal' : action;
            const tierLabels = { common: '常用', normal: '一般', rare: '冷僻' };

            cards.forEach(card => {
                const char = card.dataset.char;
                const dictKey = card.dataset.key;
                if (!char || !dictKey || dictKey === 'undefined0' || processed.has(char + dictKey)) return;
                processed.add(char + dictKey);

                moveCharTier(char, dictKey, newTier);

                // 就地更新徽章外觀（不重排）
                const badge = card.querySelector('.mark-badge');
                if (badge) {
                    badge.className = `mark-badge ${newTier}`;
                    badge.textContent = tierLabels[newTier];
                }

                // 取消選取外觀
                card.classList.remove('selected');
            });

            selectedChars.clear();
            updateBatchCount();

            // 延遲重渲染（與單字點擊共用 reorderTimer）
            if (reorderTimer) clearTimeout(reorderTimer);
            reorderTimer = setTimeout(() => {
                reorderTimer = null;
                const currentInput = document.getElementById('searchInput').value;
                if (currentInput) {
                    const container = document.getElementById('resultsContainer');
                    container.style.opacity = '0.001';
                    container.style.transition = 'opacity 0.3s ease';
                    setTimeout(() => {
                        const results = searchRhyme(currentInput);
                        displayResults(results);
                        container.style.opacity = '1';
                    }, 500);
                }
            }, REORDER_DELAY);
        }

        // 更新批量面板計數
        function updateBatchCount() {
            const el = document.getElementById('batchCount');
            if (selectedChars.size > 0) {
                el.textContent = `已選 ${selectedChars.size} 字`;
            } else {
                el.textContent = '';
            }
        }


        // 添加到最近點擊
        function addToRecentClicks(char) {
            recentClicks = recentClicks.filter(c => c !== char);
            recentClicks.unshift(char);
            if (recentClicks.length > 20) {
                recentClicks.pop();
            }
            updateRecentClicksDisplay();
        }

        // 更新最近點擊顯示
        function updateRecentClicksDisplay() {
            const container = document.getElementById('recentClicks');
            if (recentClicks.length === 0) {
                container.innerHTML = '<span style="color: var(--text-secondary); font-size: 0.9rem;">點擊上方的字來記錄</span>';
                return;
            }
            const ccClass = hasCustomTextColor ? ' custom-color' : '';
            container.innerHTML = recentClicks.map(char => 
                `<span class="recent-char${ccClass}">${char}</span>`
            ).join('');
        }

        // 最近點擊面板展開/收合
        function toggleRecentPanel() {
            const panel = document.getElementById('recentPanel');
            panel.classList.toggle('collapsed');
            localStorage.setItem('recentPanelCollapsed', panel.classList.contains('collapsed'));
        }

        // 初始化面板狀態
        (function() {
            const collapsed = localStorage.getItem('recentPanelCollapsed');
            if (collapsed === 'true') {
                document.getElementById('recentPanel').classList.add('collapsed');
            }
        })();

        // 顯示結果
        function displayResults(results) {

            results.forEach(r => {
                const infos = charInfo[r.char];
                if (infos) {
                    const match = infos.find(i => i.zhuyin === r.zhuyin);
                    if (match) {
                        r.tone = match.tone;
                        r.tier = match.tier;
                    } else {
                        r.tone = 0;
                        r.tier = getCharMark(r.char, r.zhuyin);
                    }
                } else {
                    r.tone = 0;
                    r.tier = 'normal';
                }
            });

            const container = document.getElementById('resultsContainer');
            const showPinyin = document.getElementById('showPinyin').checked;
            const hideRare = document.getElementById('hideRare').checked;
            const filterDup = document.getElementById('filterDuplicate').checked;

            // 過濾冷僻字
            if (hideRare) {
                results = results.filter(r => {
                    const mark = getCharMark(r.char, r.zhuyin);
                    return mark !== 'rare';
                });
            }

            // 過濾破音字（勾選時或關閉讀音時，每字只保留第一個匹配）
            if (filterDup || !showPinyin) {
                const seen = new Set();
                results = results.filter(r => {
                    if (seen.has(r.char)) return false;
                    seen.add(r.char);
                    return true;
                });
            }
            
            if (results.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <h3>沒有找到結果</h3>
                        <p>試試其他韻腳，例如：an、ing、ong</p>
                    </div>
                `;
                return;
            }
            
            const header = `
                <div class="results-header">
                    <div class="results-count">找到 ${results.length} 個字</div>
                </div>
            `;
            
            let content = '';
            
            if (currentMode === 'tone') {
                // ===== 同聲調並列模式 =====
                const toneNames = { 1: '一聲', 2: '二聲', 3: '三聲', 4: '四聲', 5: '輕聲', 0: '未標' };
                const toneOrder = [1, 2, 3, 4, 5, 0];

                const toneGroups = {};
                results.forEach(item => {
                    const t = item.tone || 0;
                    if (!toneGroups[t]) toneGroups[t] = [];
                    toneGroups[t].push(item);
                });

                const tierOrder = { common: 0, normal: 1, rare: 2 };
                for (const t of Object.keys(toneGroups)) {
                    toneGroups[t].sort((a, b) => (tierOrder[a.tier] || 1) - (tierOrder[b.tier] || 1));
                }

                toneOrder.forEach(t => {
                    if (!toneGroups[t] || toneGroups[t].length === 0) return;
                    content += `
                        <div class="group-section">
                            <div class="group-title">${toneNames[t]}（${toneGroups[t].length}）</div>
                            <div class="results-grid">
                                ${toneGroups[t].map(item => createCharCard(item, showPinyin)).join('')}
                            </div>
                        </div>
                    `;
                });
            } else if (currentMode === 'initial') {
                // ===== 同聲韻並列模式 =====
                const showAsZhuyin = lastSearchType === 'bopomofo';
                
                // 判斷是否有韻母搜尋（需按子音分組）
                const hasRhymeSearch = searchedTerms.some(s => s.isRhymeSearch);
                const hasInitialSearch = searchedTerms.some(s => s.isInitial);
                
                // 三級排序函數
                const tierSort = (a, b) => {
                    const markA = getCharMark(a.char, a.zhuyin);
                    const markB = getCharMark(b.char, b.zhuyin);
                    return (markA === 'common' ? 0 : (markA === 'rare' ? 2 : 1))
                         - (markB === 'common' ? 0 : (markB === 'rare' ? 2 : 1));
                };
                
                if (hasRhymeSearch && !hasInitialSearch) {
                    // ===== 韻母搜尋 → 按子音分組，顏色標記子音 =====
                    const consonantGroups = {};
                    results.forEach(item => {
                        const key = item.zhuyinInitial || '/';
                        if (!consonantGroups[key]) consonantGroups[key] = [];
                        consonantGroups[key].push(item);
                    });
                    
                    // 按聲母排序（/ 排最前）
                    const zhuyinOrder = ['/', ...zhuyinInitials];
                    const sortedConsonants = Object.keys(consonantGroups).sort((a, b) => {
                        return zhuyinOrder.indexOf(a) - zhuyinOrder.indexOf(b);
                    });
                    
                    sortedConsonants.forEach((consonant, ci) => {
                        const group = consonantGroups[consonant];
                        group.sort(tierSort);
                        // 設定顯示用的顏色索引
                        group.forEach(item => { item._displayIndex = ci; });
                        
                        const colorClass = `search-highlight-${(ci % 5) + 1}`;
                        let displayTitle = consonant;
                        if (!showAsZhuyin && consonant !== '/') {
                            displayTitle = zhuyinInitialToPinyin[consonant] || consonant;
                        }
                        
                        content += `
                            <div class="group-section">
                                <div class="group-title rhyme-group"><span class="${colorClass}">[${displayTitle}]</span>（${group.length}）</div>
                                <div class="results-grid">
                                    ${group.map(item => createCharCard(item, showPinyin, 'initial')).join('')}
                                </div>
                            </div>
                        `;
                    });
                } else if (hasInitialSearch && !hasRhymeSearch) {
                    // ===== 子音搜尋 → 按韻母家族分組，顏色標記母音 =====
                    const grouped = {};
                    results.forEach(item => {
                        const gKey = item.rhymeIndex !== undefined ? item.rhymeIndex : 0;
                        if (!grouped[gKey]) grouped[gKey] = [];
                        grouped[gKey].push(item);
                    });
                    
                    const sortedKeys = Object.keys(grouped).sort((a, b) => parseInt(a) - parseInt(b));
                    
                    sortedKeys.forEach(gKey => {
                        const group = grouped[gKey];
                        const searchTerm = searchedTerms.find(s => s.index === parseInt(gKey));
                        
                        // 標題：顯示該組實際出現的韻母
                        let displayTitle = '';
                        if (searchTerm) {
                            const members = searchTerm.rhymeMembers || [searchTerm.zhuyin];
                            if (showAsZhuyin) {
                                displayTitle = members.join('.');
                            } else {
                                displayTitle = members.map(m => rhymeToPinyinLabel[m] || fullZhuyinToPinyin[m] || m).join('.');
                            }
                        }
                        
                        group.sort(tierSort);
                        const colorClass = `search-highlight-${(parseInt(gKey) % 5) + 1}`;
                        
                        content += `
                            <div class="group-section">
                                <div class="group-title rhyme-group"><span class="${colorClass}">[${displayTitle}]</span>（${group.length}）</div>
                                <div class="results-grid">
                                    ${group.map(item => createCharCard(item, showPinyin, 'rhyme')).join('')}
                                </div>
                            </div>
                        `;
                    });
                } else {
                    // ===== 混合搜尋 / PINYIN_SPECIAL → 按 rhymeIndex 分組 =====
                    const grouped = {};
                    results.forEach(item => {
                        const gKey = item.rhymeIndex !== undefined ? item.rhymeIndex : 0;
                        if (!grouped[gKey]) grouped[gKey] = [];
                        grouped[gKey].push(item);
                    });
                    
                    const sortedKeys = Object.keys(grouped).sort((a, b) => parseInt(a) - parseInt(b));
                    
                    sortedKeys.forEach(gKey => {
                        const group = grouped[gKey];
                        const searchTerm = searchedTerms.find(s => s.index === parseInt(gKey));
                        let displayTitle = '';
                        if (searchTerm) {
                            if (showAsZhuyin) {
                                displayTitle = searchTerm.zhuyin || searchTerm.original;
                            } else {
                                const zy = searchTerm.zhuyin || '';
                                displayTitle = fullZhuyinToPinyin[zy] || searchTerm.original;
                            }
                        }
                        
                        group.sort(tierSort);
                        const colorClass = `search-highlight-${(parseInt(gKey) % 5) + 1}`;
                        // 混合模式：根據該組的 searchTerm 決定高亮目標
                        const hlTarget = searchTerm && searchTerm.isRhymeSearch ? 'initial' : 'rhyme';
                        
                        content += `
                            <div class="group-section">
                                <div class="group-title rhyme-group"><span class="${colorClass}">[${displayTitle}]</span>（${group.length}）</div>
                                <div class="results-grid">
                                    ${group.map(item => createCharCard(item, showPinyin, hlTarget)).join('')}
                                </div>
                            </div>
                        `;
                    });
                }
            } else {
                // 常用字優先模式：三級排序
                results.sort((a, b) => {
                    const markA = getCharMark(a.char, a.zhuyin);
                    const markB = getCharMark(b.char, b.zhuyin);
                    const orderA = markA === 'common' ? 0 : (markA === 'rare' ? 2 : 1);
                    const orderB = markB === 'common' ? 0 : (markB === 'rare' ? 2 : 1);
                    return orderA - orderB;
                });
                
                content = `<div class="results-grid">
                    ${results.map(item => createCharCard(item, showPinyin)).join('')}
                </div>`;
            }
            
            container.innerHTML = header + content;
            
            // 點擊事件（使用事件委派）
            const resultsContainer = document.getElementById('resultsContainer');
            resultsContainer.onclick = function(e) {
                if (e.target.classList.contains('mark-badge')) return;
                const card = e.target.closest('.char-card');
                if (card) {
                    const char = card.dataset.char;
                    toggleSelection(char, card);
                }
            };
        }

        // 事件監聽器
        const searchInputEl = document.getElementById('searchInput');
        
        // 偏好設定面板
        function toggleSettings() {
            const overlay = document.getElementById('settingsOverlay');
            overlay.classList.toggle('show');
        }

        function closeSettingsOverlay(event) {
            // 點擊遮罩本身才關閉（內容區已 stopPropagation）
            if (event.target === event.currentTarget) {
                document.getElementById('settingsOverlay').classList.remove('show');
            }
        }

        function toggleAbout() {
            document.getElementById('aboutOverlay').classList.toggle('show');
        }

        function closeAbout(event) {
            if (event.target === event.currentTarget) {
                document.getElementById('aboutOverlay').classList.remove('show');
            }
        }
        // 標準 input 事件
        searchInputEl.addEventListener('input', (e) => {
            // 如果正在輸入法組字中（如注音輸入法），跳過
            if (e.isComposing) return;
            const results = searchRhyme(e.target.value);
            displayResults(results);
        });
        
        // 輸入法組字完成事件（支援手機注音/拼音輸入法）
        searchInputEl.addEventListener('compositionend', (e) => {
            const results = searchRhyme(e.target.value);
            displayResults(results);
        });
        
        // 確保手機上點擊搜尋框能正確取得焦點
        searchInputEl.addEventListener('touchend', (e) => {
            setTimeout(() => e.target.focus(), 10);
        });

        document.getElementById('showPinyin').addEventListener('change', () => {
            const currentInput = document.getElementById('searchInput').value;
            if (currentInput) {
                const results = searchRhyme(currentInput);
                displayResults(results);
            }
        });
        
        document.getElementById('highlightSearch').addEventListener('change', () => {
            const currentInput = document.getElementById('searchInput').value;
            if (currentInput) {
                const results = searchRhyme(currentInput);
                displayResults(results);
            }
        });

        document.getElementById('hideRare').addEventListener('change', () => {
            const currentInput = document.getElementById('searchInput').value;
            if (currentInput) {
                const results = searchRhyme(currentInput);
                displayResults(results);
            }
        });

        document.getElementById('filterDuplicate').addEventListener('change', () => {
            const currentInput = document.getElementById('searchInput').value;
            if (currentInput) {
                const results = searchRhyme(currentInput);
                displayResults(results);
            }
        });

        // 按鈕組切換
        document.querySelectorAll('.mode-button').forEach(button => {
            button.addEventListener('click', function() {
                document.querySelectorAll('.mode-button').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                currentMode = this.dataset.mode;
                const currentInput = document.getElementById('searchInput').value;
                if (currentInput) {
                    const results = searchRhyme(currentInput);
                    displayResults(results);
                }
            });
        });

        // Dark mode 切換
        const themeToggle = document.getElementById('themeToggle');
        let isDark = false;
        
        // 顏色反轉工具函數
        function invertColor(hex) {
            hex = hex.replace('#', '');
            const r = 255 - parseInt(hex.substring(0, 2), 16);
            const g = 255 - parseInt(hex.substring(2, 4), 16);
            const b = 255 - parseInt(hex.substring(4, 6), 16);
            return '#' + [r, g, b].map(c => c.toString(16).padStart(2, '0')).join('');
        }
        
        themeToggle.addEventListener('click', () => {
            isDark = !isDark;
            document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
            themeToggle.textContent = isDark ? '🌙 深色模式' : '☀️ 淺色模式' ;
            

            
            // 重新載入顏色（含反轉邏輯）
            loadColors();
            
            // 重新渲染結果以套用顏色
            const currentInput = document.getElementById('searchInput').value;
            if (currentInput) {
                const results = searchRhyme(currentInput);
                displayResults(results);
            }
        });

        // 縮放功能（只影響字卡區域）
        const zoomSlider = document.getElementById('zoomSlider');
        const zoomValue = document.getElementById('zoomValue');
        const resultsSection = document.querySelector('.results-section');

        zoomSlider.addEventListener('input', (e) => {
            zoomValue.textContent = e.target.value + '%';
        });
        
        zoomSlider.addEventListener('change', (e) => {
            const value = parseInt(e.target.value);
            const scale = value / 100;
            resultsSection.style.zoom = scale;
            resultsSection.style.transform = 'none';
        });

        // 顏色自定義
        function loadColors() {
            // 從 localStorage 讀取原始（淺色模式）顏色
            const rawColors = {
                bgColor1: localStorage.getItem('bgColor1') || '#667eea',
                containerBg: localStorage.getItem('containerBg') || '#ffffff',
                textColor: localStorage.getItem('textColor') || '#2d3748',
                highlightColor: localStorage.getItem('highlightColor') || '#ed8936'
            };
            
            // 深色模式：背景以外的顏色反轉
            let displayColors;
            if (isDark) {
                displayColors = {
                    bgColor1: rawColors.bgColor1, // 背景不反轉
                    containerBg: invertColor(rawColors.containerBg),
                    textColor: invertColor(rawColors.textColor),
                    highlightColor: invertColor(rawColors.highlightColor)
                };
            } else {
                displayColors = { ...rawColors };
            }
            
            // 更新色票 UI 顯示當前實際使用的顏色
            document.getElementById('bgColor1').value = rawColors.bgColor1; // 背景永遠顯示原色
            document.getElementById('containerBg').value = displayColors.containerBg;
            document.getElementById('textColor').value = displayColors.textColor;
            document.getElementById('highlightColor').value = displayColors.highlightColor;
            
            applyColors(displayColors, rawColors.textColor);
        }

        function applyColors(colors, rawTextColor) {
            // 背景不受深色模式影響（深色模式有自己的背景）
            if (!isDark) {
                document.documentElement.style.setProperty('--bg-gradient-1', colors.bgColor1);
                document.documentElement.style.setProperty('--bg-gradient-2', colors.bgColor1);
            }
            document.documentElement.style.setProperty('--container-bg', colors.containerBg);
            document.documentElement.style.setProperty('--highlight-border', colors.highlightColor);
            
            // 文字顏色
            const defaultTextColor = '#2d3748';
            const originalTextColor = rawTextColor || colors.textColor;
            if (originalTextColor !== defaultTextColor || isDark) {
                hasCustomTextColor = true;
                document.documentElement.style.setProperty('--custom-text-color', colors.textColor);
                document.documentElement.style.setProperty('--text-primary', colors.textColor);
            } else {
                hasCustomTextColor = false;
                document.documentElement.style.setProperty('--text-primary', colors.textColor);
            }
        }

        document.getElementById('bgColor1').addEventListener('change', (e) => {
            // 背景不反轉，直接儲存
            localStorage.setItem('bgColor1', e.target.value);
            loadColors();
        });

        document.getElementById('containerBg').addEventListener('change', (e) => {
            // 深色模式下使用者選的是反轉後的顏色，需反轉回原色再儲存
            const rawValue = isDark ? invertColor(e.target.value) : e.target.value;
            localStorage.setItem('containerBg', rawValue);
            loadColors();
        });

        document.getElementById('textColor').addEventListener('change', (e) => {
            const rawValue = isDark ? invertColor(e.target.value) : e.target.value;
            localStorage.setItem('textColor', rawValue);
            loadColors();
            // 重新渲染以套用 custom-color class
            const currentInput = document.getElementById('searchInput').value;
            if (currentInput) {
                const results = searchRhyme(currentInput);
                displayResults(results);
            }
        });

        document.getElementById('highlightColor').addEventListener('change', (e) => {
            const rawValue = isDark ? invertColor(e.target.value) : e.target.value;
            localStorage.setItem('highlightColor', rawValue);
            loadColors();
        });

        // 初始化
        loadDictOverrides();  // 先載入使用者修改，覆寫 rhymeDict
        buildIndex();

        // 手機版：將 batch panel 移入搜尋區域
        if (window.innerWidth <= 640) {
            const batchPanel = document.getElementById('batchPanel');
            const mobileArea = document.getElementById('mobileBatchArea');
            if (batchPanel && mobileArea) {
                mobileArea.appendChild(batchPanel);
            }
        }

        loadColors();
        // 只在桌面自動 focus（避免手機打開就彈出鍵盤）
        if (window.innerWidth > 640) {
            document.getElementById('searchInput').focus();
        }
    </script>
</body>
</html>
