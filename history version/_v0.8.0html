<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <!-- phone -->
    <link rel="manifest" href="manifest.json">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="好韻到">
    <link rel="apple-touch-icon" href="icon.png">
    <!-- computer -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>好韻到 | Lucky Hawaii </title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500&display=swap');
        
        :root {
            --bg-gradient-1: #667eea;
            --bg-gradient-2: #764ba2;
            --container-bg: #ffffff;
            --text-primary: #2d3748;
            --text-secondary: #718096;
            --border: #e2e8f0;
            --card-bg: #f7fafc;
            --highlight-border: #ed8936;
            --shadow: rgba(0, 0, 0, 0.1);
            --header-gradient-1: #e89e61;
            --header-gradient-2: #764ba2;
            --custom-text-color: none;
        }
        
        [data-theme="dark"] {
            --bg-gradient-1: #1a202c;
            --bg-gradient-2: #2d3748;
            --container-bg: #1a202c;
            --text-primary: #e2e8f0;
            --text-secondary: #a0aec0;
            --border: #4a5568;
            --card-bg: #2d3748;
            --header-gradient-1: #2d3748;
            --header-gradient-2: #4a5568;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Noto Sans TC', sans-serif;
            background: linear-gradient(135deg, var(--bg-gradient-1) 0%, var(--bg-gradient-2) 100%);
            min-height: 100vh;
            padding: 20px;
            color: var(--text-primary);
            transition: background 0.3s ease;
        }
        
        .container {
            max-width: 900px;
            margin: 0 auto;
            background: var(--container-bg);
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            height: calc(100vh - 40px);
            display: flex;
            flex-direction: column;
            animation: slideIn 0.5s ease-out;
            transition: background 0.3s ease, box-shadow 0.3s ease;
        }
        
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .header {
            background: linear-gradient(135deg, var(--header-gradient-1) 0%, var(--header-gradient-2) 100%);
            color: white;
            padding: 40px 30px;
            text-align: center;
            position: relative;
            flex-shrink: 0;
        }
        
        .header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
            letter-spacing: -0.5px;
        }
        
        .header p {
            font-size: 1rem;
            opacity: 0.9;
            font-weight: 300;
        }
        
        /* 顏色自定義面板 */
        .color-panel {
            position: absolute;
            top: 15px;
            left: 15px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            border-radius: 12px;
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        
        .color-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.75rem;
            color: white;
        }
        
        .color-item label {
            min-width: 60px;
            font-weight: 500;
        }
        
        .color-item input[type="color"] {
            width: 30px;
            height: 24px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        
        /* 控制面板 */
        .controls {
            position: absolute;
            top: 15px;
            right: 15px;
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .theme-toggle, .zoom-control {
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            border: none;
            color: white;
            padding: 8px 12px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }
        
        .theme-toggle:hover, .zoom-control:hover {
            background: rgba(255, 255, 255, 0.3);
        }
        
        .zoom-control {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 15px;
        }
        
        .zoom-control input[type="range"] {
            width: 80px;
            cursor: pointer;
        }
        
        .search-section {
            padding: 20px 30px;
            background: var(--container-bg);
            flex-shrink: 0;
        }
        
        .search-box {
            position: relative;
            margin-bottom: 20px;
        }
        

        .search-input {
            width: 100%;
            padding: 18px 24px;
            font-size: 1.2rem;
            border: 3px solid var(--border);
            border-radius: 12px;
            outline: none;
            transition: all 0.3s ease;
            font-family: 'Noto Sans TC', sans-serif;
            background: var(--container-bg);
            color: var(--text-primary);
        }
        
        .search-input:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        
        .search-hint {
            font-size: 0.9rem;
            color: var(--text-secondary);
            margin-top: 8px;
            font-weight: 300;
        }
        
        .options {
            display: flex;
            gap: 15px;
            align-items: center;
            flex-wrap: wrap;
        }
        
        .checkbox-label {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            user-select: none;
            font-size: 0.95rem;
            color: var(--text-secondary);
        }
        
        .checkbox-label input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }
        
        /* 按鈕組 */
        .button-group {
            display: flex;
            gap: 8px;
            background: var(--card-bg);
            padding: 4px;
            border-radius: 10px;
            border: 1px solid var(--border);
        }
        
        .mode-button {
            padding: 8px 16px;
            border: none;
            background: transparent;
            color: var(--text-secondary);
            cursor: pointer;
            border-radius: 6px;
            font-size: 0.9rem;
            font-family: 'Noto Sans TC', sans-serif;
            transition: all 0.2s ease;
            font-weight: 500;
        }
        
        .mode-button.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        
        .mode-button:hover:not(.active) {
            background: var(--border);
        }
        
        /* 偏好設定面板 */
        .settings-trigger {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 14px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--card-bg);
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 0.9rem;
            font-family: 'Noto Sans TC', sans-serif;
            transition: all 0.2s ease;
            user-select: none;
            position: relative;
        }

        .settings-trigger:hover {
            background: var(--border);
        }

        .settings-trigger .gear-icon {
            font-size: 1rem;
            transition: transform 0.3s ease;
        }

        .settings-trigger.open .gear-icon {
            transform: rotate(90deg);
        }

        .settings-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.3);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            z-index: 999;
            justify-content: center;
            align-items: center;
        }

        .settings-overlay.show {
            display: flex;
        }

        .settings-dropdown {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 24px 28px;
            box-shadow: 0 12px 40px rgba(0,0,0,0.2);
            min-width: 220px;
            max-width: 320px;
        }

        .settings-dropdown.show {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .settings-dropdown-title {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 4px;
            text-align: center;
        }

        /* 桌面：隱藏設定面板內的顏色區塊（已在 header 顯示） */
        .settings-color-section {
            display: none;
        }

        .results-section {
            padding: 30px;
            min-height: 300px;
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            border-top: 5px solid var(--border);
            scrollbar-width: thin;
        }

        .results-section::-webkit-scrollbar { width: 6px; }
        .results-section::-webkit-scrollbar-track { background: transparent; }
        .results-section::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.2); border-radius: 3px; }
        
        .results-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .results-count {
            font-size: 1.1rem;
            color: var(--text-secondary);
            font-weight: 500;
        }
        
        /* 分組標題 */
        .group-section {
            margin-bottom: 30px;
        }
        
        .group-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 15px;
            padding: 8px 12px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 8px;
            display: inline-block;
        }

        .group-title.rhyme-group {
            background: var(--card-bg);
            border: 2px solid var(--border);
        }

        .group-title.rhyme-group span[class^="search-highlight"] {
            font-weight: 700;
        }
        
        .results-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
            gap: 12px;
            animation: fadeIn 0.4s ease-out;
        }
        
        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }
        
        .char-card {
            background: var(--card-bg);
            border: 2px solid var(--border);
            border-radius: 8px;
            padding: 12px;
            text-align: center;
            transition: all 0.2s ease;
            cursor: pointer;
            user-select: none;
            position: relative;
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation;
        }
        
        .char-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px var(--shadow);
            border-color: #667eea;
        }
        
        .char-card.selected {
            border-color: var(--highlight-border);
            border-width: 3px;
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
        }
        
        .char-main {
            font-size: 2rem;
            font-weight: 500;
            margin-bottom: 4px;
        }

        /* 自定義文字顏色：始終優先，不被深色模式覆蓋 */
        .char-main.custom-color {
            color: var(--custom-text-color) !important;
        }
        
        .char-pinyin {
            font-size: 0.85rem;
            color: var(--text-secondary);
            font-family: 'JetBrains Mono', monospace;
            text-align: center;
        }

        .tone-mark {
            display: inline-block;
            width: 0;
            overflow: visible;
            text-align: left;
            vertical-align: top;
            font-size: 0.9em;
        }
        
        /* 常用/冷僻標記 - 可點擊區域 */
        .mark-badge {
            display: inline-block;
            font-size: 0.65rem;
            padding: 2px 6px;
            border-radius: 4px;
            margin-top: 4px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
            min-width: 32px;
            min-height: 18px;
            line-height: 14px;
        }

        .mark-badge:hover {
            transform: scale(1.1);
            filter: brightness(1.1);
        }
        
        .mark-badge.common {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
        }

        .mark-badge.normal {
            background: var(--border);
            color: var(--text-secondary);
        }
        
        .mark-badge.rare {
            background: linear-gradient(135deg, #667eea 0%, #4299e1 100%);
            color: white;
        }
        
        /* 搜尋內容高亮樣式 - 多顏色 */
        .search-highlight-1 { color: #ed8936; font-weight: 700; }
        .search-highlight-2 { color: #48bb78; font-weight: 700; }
        .search-highlight-3 { color: #4299e1; font-weight: 700; }
        .search-highlight-4 { color: #9f7aea; font-weight: 700; }
        .search-highlight-5 { color: #ed64a6; font-weight: 700; }
        
        /* 最近點擊浮動面板 */
        .recent-panel {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background: var(--card-bg);
            border-top: 2px solid var(--border);
            box-shadow: 0 -4px 20px rgba(0,0,0,0.12);
            transition: transform 0.3s ease;
            max-height: 105vh;
            display: flex;
            flex-direction: column;
        }

        .recent-panel.collapsed {
            transform: translateY(calc(100% - 38px));
        }

        .recent-panel-header {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 8px 20px;
            cursor: pointer;
            user-select: none;
            flex-shrink: 0;
            min-height: 38px;
            border-bottom: 1px solid var(--border);
        }

        .recent-panel-header:hover {
            background: var(--container-bg);
        }

        .recent-panel-title {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--text-primary);
        }

        .recent-panel-toggle {
            font-size: 0.8rem;
            color: var(--text-secondary);
            transition: transform 0.3s ease;
        }

        .recent-panel.collapsed .recent-panel-toggle {
            transform: rotate(180deg);
        }

        .recent-panel-body {
            padding: 10px 20px 14px;
            overflow-y: auto;
            flex: 1;
            min-height: 80px;
        }

        .recent-clicks-container {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            min-height: 32px;
        }

        .recent-char {
            background: var(--container-bg);
            border: 1px solid var(--border);
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 1.2rem;
            color: var(--text-primary);
        }

        .recent-char.custom-color {
            color: var(--custom-text-color) !important;
        }

        .recent-char:hover {
            background: #667eea;
            color: white;
            transform: scale(1.05);
        }

        /* 給主內容留出底部空間避免被面板遮擋 */
        .results-section {
            padding-bottom: 100px;
        }
        
        /* 批量標記浮動面板 */
        .batch-panel {
            position: fixed;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 900;
            display: flex;
            flex-direction: column;
            gap: 8px;
            transition: opacity 0.3s ease;
        }

        .batch-btn {
            width: 96px;
            height: 96px;
            border: 2px solid var(--border);
            border-radius: 10px;
            background: var(--card-bg);
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 4px;
            font-family: 'Noto Sans TC', sans-serif;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-secondary);
            transition: all 0.2s ease;
            box-shadow: 0 2px 8px var(--shadow);
        }

        .batch-btn:hover {
            transform: scale(1.05);
            border-color: #667eea;
        }

        .batch-btn .batch-icon {
            font-size: 1.5rem;
        }

        .batch-btn.btn-common { border-left: 4px solid #f5576c; }
        .batch-btn.btn-rare { border-left: 4px solid #4299e1; }
        .batch-btn.btn-clear { border-left: 4px solid #a0aec0; }

        .batch-count {
            text-align: center;
            font-size: 0.75rem;
            color: var(--text-secondary);
            padding: 2px 0;
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--text-secondary);
        }
        
        .empty-state svg {
            width: 80px;
            height: 80px;
            margin-bottom: 20px;
            opacity: 0.3;
        }
        
        .empty-state h3 {
            font-size: 1.2rem;
            margin-bottom: 8px;
            color: var(--text-primary);
        }
        
        .empty-state p {
            font-size: 0.95rem;
        }
        
        .footer {
            padding: 20px 30px;
            background: var(--card-bg);
            text-align: center;
            font-size: 0.85rem;
            color: var(--text-secondary);
            flex-shrink: 0;
            position: relative;
        }

        .about-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            border: 1.5px solid var(--text-secondary);
            color: var(--text-secondary);
            font-size: 0.75rem;
            font-weight: 700;
            font-style: italic;
            font-family: Georgia, serif;
            cursor: pointer;
            margin-left: 8px;
            vertical-align: middle;
            transition: all 0.2s ease;
        }

        .about-btn:hover {
            border-color: #667eea;
            color: #667eea;
            background: rgba(102, 126, 234, 0.1);
        }

        .about-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.3);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            z-index: 999;
            justify-content: center;
            align-items: center;
        }

        .about-overlay.show { display: flex; }

        .about-content {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 30px 34px;
            box-shadow: 0 12px 40px rgba(0,0,0,0.2);
            max-width: 400px;
            width: 90%;
            text-align: center;
        }

        .about-content h3 {
            margin-bottom: 12px;
            font-size: 1.2rem;
        }

        .about-content p {
            font-size: 0.9rem;
            color: var(--text-secondary);
            line-height: 1.6;
            margin-bottom: 8px;
        }
        
        @media (max-width: 640px) {
            .header {
                padding: 20px 15px 30px;
            }
            
            .header h1 {
                font-size: 1.8rem;
            }
            
            .search-section {
                padding: 20px 15px;
            }
            
            .search-input {
                font-size: 16px; /* 防止 iOS 自動縮放 */
                padding: 14px 18px;
                -webkit-appearance: none;
                appearance: none;
                border-radius: 12px;
            }
            
            .results-section {
                padding: 15px;
            }
            
            .results-grid {
                grid-template-columns: repeat(auto-fill, minmax(65px, 1fr));
                gap: 8px;
            }
            
            .char-card {
                padding: 8px 4px;
            }
            
            .char-main {
                font-size: 1.5rem;
            }
            
            .char-pinyin {
                font-size: 0.7rem;
            }
            
            .mark-badge {
                font-size: 0.6rem;
                padding: 1px 4px;
                min-width: 28px;
            }
            
            .color-panel {
                position: static;
                flex-direction: row;
                flex-wrap: wrap;
                margin-bottom: 15px;
                justify-content: center;
            }
            
            .controls {
                position: static;
                justify-content: center;
                margin-top: 15px;
                flex-wrap: wrap;
            }
            
            .options {
                gap: 10px;
            }
            
            .button-group {
                width: 100%;
                justify-content: center;
            }

            .options {
                flex-direction: column;
                align-items: stretch;
            }

            .settings-trigger {
                align-self: flex-end;
            }
            
            /* mobile screen */
            .recent-panel-body {
                padding: 8px 20px 10px;
            }
            .recent-panel-header {
                padding: 6px 12px;
            }
            
            .batch-panel {
                right: 8px;
            }

            .batch-btn {
                width: 60px;
                height: 60px;
                font-size: 0.65rem;
            }

            .batch-btn .batch-icon {
                font-size: 1.1rem;
            }

            .checkbox-label {
                font-size: 0.85rem;
            }

            /* 手機：隱藏 header 顏色面板，顯示設定面板內的顏色 */
            .color-panel {
                display: none !important;
            }
            
            .settings-color-section {
                display: block !important;
            }

            /* 手機：batch 移到 header 區域 */
            .batch-panel {
                position: static;
                transform: none;
                flex-direction: row;
                justify-content: center;
                padding: 10px 15px;
                background: var(--container-bg);
                border-bottom: 1px solid var(--border);
            }

            .batch-btn {
                width: auto;
                height: auto;
                padding: 8px 14px;
                flex-direction: row;
                gap: 6px;
            }

            .batch-btn .batch-icon {
                font-size: 1rem;
            }

            .batch-count {
                padding: 4px 0;
            }

            .mobile-batch-area {
                display: block;
            }

        }

    </style>
</head>
<body>

    <div class="container" id="mainContainer">
        <div class="header">
            <!-- 顏色自定義面板 -->
            <div class="color-panel">
                <div class="color-item">
                    <label>背景</label>
                    <input type="color" id="bgColor1" value="#667eea">
                </div>
                <div class="color-item">
                    <label>底色</label>
                    <input type="color" id="containerBg" value="#ffffff">
                </div>
                <div class="color-item">
                    <label>文字</label>
                    <input type="color" id="textColor" value="#2d3748">
                </div>
                <div class="color-item">
                    <label>邊框</label>
                    <input type="color" id="highlightColor" value="#ed8936">
                </div>
            </div>
            
            <!-- 控制面板 -->
            <div class="controls">
                <button class="theme-toggle" id="themeToggle"> ☀️ 淺色模式 </button>
                <div class="zoom-control">
                    <span>🔍</span>
                    <input type="range" id="zoomSlider" min="50" max="150" value="100" step="5">
                    <span id="zoomValue">100%</span>
                </div>
            </div>
            
            <h1>韻腳查詢器 📝</h1>
            <p>寫歌詞...不簡單...甘巴爹...早點睡...</p>
        </div>
        
        <div class="search-section">
            <div class="search-box">
                <input 
                    type="text" 
                    id="searchInput" 
                    class="search-input" 
                    placeholder="輸入注音或拼音，例如：ㄢ 或 an"
                    autocomplete="off"
                    autocorrect="off"
                    autocapitalize="off"
                    spellcheck="false"
                    inputmode="text"
                    enterkeyhint="search"
                >
                <div class="search-hint">
                    💡 支援注音（ㄅㄆㄇ）或拼音（ban、pan）輸入，也可輸入子音（如 ㄈ）查找所有符合該子音開頭的字
                </div>
            </div>
            
            <div class="mobile-batch-area" id="mobileBatchArea"></div>

            <div class="options" style="justify-content: space-between;">
                <div class="button-group">
                    <button class="mode-button active" data-mode="common">常用字優先</button>
                    <button class="mode-button" data-mode="initial">同聲韻並列</button>
                    <button class="mode-button" data-mode="tone">同聲調並列</button>
                </div>

                <div class="settings-trigger" id="settingsTrigger" onclick="toggleSettings()">
                    <span class="gear-icon">⚙</span>
                    <span>偏好設定</span>
                </div>
            </div>
        </div>
        
        <div class="results-section">
            <div id="resultsContainer">
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    <h3>開始搜尋</h3>
                    <p>在上方輸入注音或拼音來尋找押韻的字</p>
                </div>
            </div>
        </div>

        <div class="footer">
            創作者專屬工具 · 告知作者後可分享 ( 因為還在開發中 >_< )　　　2026.02 beta v0.8 _by Lyx
            <span class="about-btn" onclick="toggleAbout()">i</span>
        </div>

        <div class="about-overlay" id="aboutOverlay" onclick="closeAbout(event)">
            <div class="about-content" onclick="event.stopPropagation()">
                <h3>好韻到｜Lucky Hawaii</h3>
                <p>版本 v0.8 beta</p>
                <p>有鑑於目前網路上的韻腳查詢工具幾乎都是以「詞」為架構，並且容易混雜著大量的冷僻詞彙，因此特別開發針對「常用字」為索引系統的工具。</p>
                <p>子音與母音皆可搜尋、支援漢語拼音系統。</p>
                <p>2026.02 Lyx</p>
            </div>
        </div>
        
        <div class="settings-overlay" id="settingsOverlay" onclick="closeSettingsOverlay(event)">
            <div class="settings-dropdown show" onclick="event.stopPropagation()">
                <div class="settings-dropdown-title">⚙ 偏好設定</div>
                <label class="checkbox-label">
                    <input type="checkbox" id="showPinyin" checked>
                    <span>顯示讀音</span>
                </label>
                <label class="checkbox-label">
                    <input type="checkbox" id="highlightSearch" checked>
                    <span>標記搜尋</span>
                </label>
                <label class="checkbox-label">
                    <input type="checkbox" id="hideRare" checked>
                    <span>隱藏冷僻字</span>
                </label>
                <label class="checkbox-label">
                    <input type="checkbox" id="filterDuplicate">
                    <span>過濾破音字</span>
                </label>
                <div class="settings-color-section" id="settingsColorSection">
                    <div style="font-size:0.85rem; color:var(--text-secondary); margin-top:8px; margin-bottom:4px;">客製顏色</div>
                    <div style="display:flex; flex-wrap:wrap; gap:10px;">
                        <div class="color-item"><label>背景</label><input type="color" id="bgColor1" value="#667eea"></div>
                        <div class="color-item"><label>底色</label><input type="color" id="containerBg" value="#ffffff"></div>
                        <div class="color-item"><label>文字</label><input type="color" id="textColor" value="#2d3748"></div>
                        <div class="color-item"><label>邊框</label><input type="color" id="highlightColor" value="#ed8936"></div>
                    </div>
                </div>
            </div>
        </div>
    
    </div>

    <div class="batch-panel" id="batchPanel">
        <div class="batch-count" id="batchCount"></div>
        <button class="batch-btn btn-common" onclick="batchMark('common')">
            <span class="batch-icon">⭐</span>
            <span>標記為<br>常用</span>
        </button>
        <button class="batch-btn btn-rare" onclick="batchMark('rare')">
            <span class="batch-icon">📦</span>
            <span>標記為<br>冷僻</span>
        </button>
        <button class="batch-btn btn-clear" onclick="batchMark('clear')">
            <span class="batch-icon">↩</span>
            <span>取消<br>標記</span>
        </button>
    </div>

    <div class="recent-panel" id="recentPanel">
        <div class="recent-panel-header" onclick="toggleRecentPanel()">
            <span class="recent-panel-title">最近點擊</span>
            <span class="recent-panel-toggle">▼</span>
        </div>
        <div class="recent-panel-body">
            <div class="recent-clicks-container" id="recentClicks">
                <span style="color: var(--text-secondary); font-size: 0.9rem;">點擊上方的字來記錄</span>
            </div>
        </div>
    </div>

    <script>
        // ==================== 注音優先架構 v1.0 ====================
        
        // 注音聲母表（21個聲母）
        const zhuyinInitials = ['ㄅ','ㄆ','ㄇ','ㄈ','ㄉ','ㄊ','ㄋ','ㄌ','ㄍ','ㄎ','ㄏ',
                               'ㄐ','ㄑ','ㄒ','ㄓ','ㄔ','ㄕ','ㄖ','ㄗ','ㄘ','ㄙ'];
        const zhuyinInitialSet = new Set(zhuyinInitials);
        
        // 拼音聲母表（用於辨識拼音輸入）
        const pinyinInitials = ['zh','ch','sh','b','p','m','f','d','t','n','l','g','k','h',
                               'j','q','x','r','z','c','s'];
        
        // ===== 完整注音↔拼音查找表（404組一對一映射）=====
        const fullZhuyinToPinyin = {
            'ㄅㄧ':'bi','ㄅㄧㄝ':'bie','ㄅㄧㄠ':'biao','ㄅㄧㄢ':'bian','ㄅㄧㄣ':'bin','ㄅㄧㄥ':'bing',
            'ㄅㄨ':'bu','ㄅㄚ':'ba','ㄅㄛ':'bo','ㄅㄞ':'bai','ㄅㄟ':'bei','ㄅㄠ':'bao',
            'ㄅㄢ':'ban','ㄅㄣ':'ben','ㄅㄤ':'bang','ㄅㄥ':'beng',
            'ㄆㄧ':'pi','ㄆㄧㄝ':'pie','ㄆㄧㄠ':'piao','ㄆㄧㄢ':'pian','ㄆㄧㄣ':'pin','ㄆㄧㄥ':'ping',
            'ㄆㄨ':'pu','ㄆㄚ':'pa','ㄆㄛ':'po','ㄆㄞ':'pai','ㄆㄟ':'pei','ㄆㄠ':'pao',
            'ㄆㄡ':'pou','ㄆㄢ':'pan','ㄆㄣ':'pen','ㄆㄤ':'pang','ㄆㄥ':'peng',
            'ㄇㄧ':'mi','ㄇㄧㄝ':'mie','ㄇㄧㄠ':'miao','ㄇㄧㄡ':'miu','ㄇㄧㄢ':'mian','ㄇㄧㄣ':'min','ㄇㄧㄥ':'ming',
            'ㄇㄨ':'mu','ㄇㄚ':'ma','ㄇㄛ':'mo','ㄇㄜ':'me','ㄇㄞ':'mai','ㄇㄟ':'mei','ㄇㄠ':'mao',
            'ㄇㄡ':'mou','ㄇㄢ':'man','ㄇㄣ':'men','ㄇㄤ':'mang','ㄇㄥ':'meng',
            'ㄈㄨ':'fu','ㄈㄚ':'fa','ㄈㄛ':'fo','ㄈㄟ':'fei','ㄈㄡ':'fou','ㄈㄢ':'fan','ㄈㄣ':'fen','ㄈㄤ':'fang','ㄈㄥ':'feng',
            'ㄉㄧ':'di','ㄉㄧㄝ':'die','ㄉㄧㄠ':'diao','ㄉㄧㄡ':'diu','ㄉㄧㄢ':'dian','ㄉㄧㄥ':'ding',
            'ㄉㄨ':'du','ㄉㄨㄛ':'duo','ㄉㄨㄟ':'dui','ㄉㄨㄢ':'duan','ㄉㄨㄣ':'dun','ㄉㄨㄥ':'dong',
            'ㄉㄚ':'da','ㄉㄜ':'de','ㄉㄞ':'dai','ㄉㄟ':'dei','ㄉㄠ':'dao','ㄉㄡ':'dou','ㄉㄢ':'dan','ㄉㄤ':'dang','ㄉㄥ':'deng',
            'ㄊㄧ':'ti','ㄊㄧㄝ':'tie','ㄊㄧㄠ':'tiao','ㄊㄧㄢ':'tian','ㄊㄧㄥ':'ting',
            'ㄊㄨ':'tu','ㄊㄨㄛ':'tuo','ㄊㄨㄟ':'tui','ㄊㄨㄢ':'tuan','ㄊㄨㄣ':'tun','ㄊㄨㄥ':'tong',
            'ㄊㄚ':'ta','ㄊㄜ':'te','ㄊㄞ':'tai','ㄊㄠ':'tao','ㄊㄡ':'tou','ㄊㄢ':'tan','ㄊㄤ':'tang','ㄊㄥ':'teng',
            'ㄋㄧ':'ni','ㄋㄧㄝ':'nie','ㄋㄧㄠ':'niao','ㄋㄧㄡ':'niu','ㄋㄧㄢ':'nian','ㄋㄧㄣ':'nin','ㄋㄧㄤ':'niang','ㄋㄧㄥ':'ning',
            'ㄋㄨ':'nu','ㄋㄨㄛ':'nuo','ㄋㄨㄢ':'nuan','ㄋㄨㄥ':'nong',
            'ㄋㄩ':'nu','ㄋㄩㄝ':'nue',
            'ㄋㄚ':'na','ㄋㄜ':'ne','ㄋㄞ':'nai','ㄋㄟ':'nei','ㄋㄠ':'nao','ㄋㄡ':'nou','ㄋㄢ':'nan','ㄋㄣ':'nen','ㄋㄤ':'nang','ㄋㄥ':'neng',
            'ㄌㄧ':'li','ㄌㄧㄚ':'lia','ㄌㄧㄝ':'lie','ㄌㄧㄠ':'liao','ㄌㄧㄡ':'liu','ㄌㄧㄢ':'lian','ㄌㄧㄣ':'lin','ㄌㄧㄤ':'liang','ㄌㄧㄥ':'ling',
            'ㄌㄨ':'lu','ㄌㄨㄛ':'luo','ㄌㄨㄢ':'luan','ㄌㄨㄣ':'lun','ㄌㄨㄥ':'long',
            'ㄌㄩ':'lu','ㄌㄩㄝ':'lue','ㄌㄩㄢ':'luan',
            'ㄌㄚ':'la','ㄌㄜ':'le','ㄌㄞ':'lai','ㄌㄟ':'lei','ㄌㄠ':'lao','ㄌㄡ':'lou','ㄌㄢ':'lan','ㄌㄤ':'lang','ㄌㄥ':'leng',
            'ㄍㄨ':'gu','ㄍㄨㄚ':'gua','ㄍㄨㄛ':'guo','ㄍㄨㄞ':'guai','ㄍㄨㄟ':'gui','ㄍㄨㄢ':'guan','ㄍㄨㄣ':'gun','ㄍㄨㄤ':'guang','ㄍㄨㄥ':'gong',
            'ㄍㄚ':'ga','ㄍㄜ':'ge','ㄍㄞ':'gai','ㄍㄟ':'gei','ㄍㄠ':'gao','ㄍㄡ':'gou','ㄍㄢ':'gan','ㄍㄣ':'gen','ㄍㄤ':'gang','ㄍㄥ':'geng',
            'ㄎㄨ':'ku','ㄎㄨㄚ':'kua','ㄎㄨㄛ':'kuo','ㄎㄨㄞ':'kuai','ㄎㄨㄟ':'kui','ㄎㄨㄢ':'kuan','ㄎㄨㄣ':'kun','ㄎㄨㄤ':'kuang','ㄎㄨㄥ':'kong',
            'ㄎㄚ':'ka','ㄎㄜ':'ke','ㄎㄞ':'kai','ㄎㄠ':'kao','ㄎㄡ':'kou','ㄎㄢ':'kan','ㄎㄣ':'ken','ㄎㄤ':'kang','ㄎㄥ':'keng',
            'ㄏㄨ':'hu','ㄏㄨㄚ':'hua','ㄏㄨㄛ':'huo','ㄏㄨㄞ':'huai','ㄏㄨㄟ':'hui','ㄏㄨㄢ':'huan','ㄏㄨㄣ':'hun','ㄏㄨㄤ':'huang','ㄏㄨㄥ':'hong',
            'ㄏㄚ':'ha','ㄏㄜ':'he','ㄏㄞ':'hai','ㄏㄟ':'hei','ㄏㄠ':'hao','ㄏㄡ':'hou','ㄏㄢ':'han','ㄏㄣ':'hen','ㄏㄤ':'hang','ㄏㄥ':'heng',
            'ㄐㄧ':'ji','ㄐㄧㄚ':'jia','ㄐㄧㄝ':'jie','ㄐㄧㄠ':'jiao','ㄐㄧㄡ':'jiu','ㄐㄧㄢ':'jian','ㄐㄧㄣ':'jin','ㄐㄧㄤ':'jiang','ㄐㄧㄥ':'jing',
            'ㄐㄩ':'ju','ㄐㄩㄝ':'jue','ㄐㄩㄢ':'juan','ㄐㄩㄣ':'jun','ㄐㄩㄥ':'jiong',
            'ㄑㄧ':'qi','ㄑㄧㄚ':'qia','ㄑㄧㄝ':'qie','ㄑㄧㄠ':'qiao','ㄑㄧㄡ':'qiu','ㄑㄧㄢ':'qian','ㄑㄧㄣ':'qin','ㄑㄧㄤ':'qiang','ㄑㄧㄥ':'qing',
            'ㄑㄩ':'qu','ㄑㄩㄝ':'que','ㄑㄩㄢ':'quan','ㄑㄩㄣ':'qun','ㄑㄩㄥ':'qiong',
            'ㄒㄧ':'xi','ㄒㄧㄚ':'xia','ㄒㄧㄝ':'xie','ㄒㄧㄠ':'xiao','ㄒㄧㄡ':'xiu','ㄒㄧㄢ':'xian','ㄒㄧㄣ':'xin','ㄒㄧㄤ':'xiang','ㄒㄧㄥ':'xing',
            'ㄒㄩ':'xu','ㄒㄩㄝ':'xue','ㄒㄩㄢ':'xuan','ㄒㄩㄣ':'xun','ㄒㄩㄥ':'xiong',
            'ㄓ':'zhi','ㄓㄨ':'zhu','ㄓㄨㄚ':'zhua','ㄓㄨㄛ':'zhuo','ㄓㄨㄞ':'zhuai','ㄓㄨㄟ':'zhui','ㄓㄨㄢ':'zhuan','ㄓㄨㄣ':'zhun','ㄓㄨㄤ':'zhuang','ㄓㄨㄥ':'zhong',
            'ㄓㄚ':'zha','ㄓㄜ':'zhe','ㄓㄞ':'zhai','ㄓㄟ':'zhei','ㄓㄠ':'zhao','ㄓㄡ':'zhou','ㄓㄢ':'zhan','ㄓㄣ':'zhen','ㄓㄤ':'zhang','ㄓㄥ':'zheng',
            'ㄔ':'chi','ㄔㄨ':'chu','ㄔㄨㄛ':'chuo','ㄔㄨㄞ':'chuai','ㄔㄨㄟ':'chui','ㄔㄨㄢ':'chuan','ㄔㄨㄣ':'chun','ㄔㄨㄤ':'chuang','ㄔㄨㄥ':'chong',
            'ㄔㄚ':'cha','ㄔㄜ':'che','ㄔㄞ':'chai','ㄔㄠ':'chao','ㄔㄡ':'chou','ㄔㄢ':'chan','ㄔㄣ':'chen','ㄔㄤ':'chang','ㄔㄥ':'cheng',
            'ㄕ':'shi','ㄕㄨ':'shu','ㄕㄨㄚ':'shua','ㄕㄨㄛ':'shuo','ㄕㄨㄞ':'shuai','ㄕㄨㄟ':'shui','ㄕㄨㄢ':'shuan','ㄕㄨㄣ':'shun','ㄕㄨㄤ':'shuang',
            'ㄕㄚ':'sha','ㄕㄜ':'she','ㄕㄞ':'shai','ㄕㄟ':'shei','ㄕㄠ':'shao','ㄕㄡ':'shou','ㄕㄢ':'shan','ㄕㄣ':'shen','ㄕㄤ':'shang','ㄕㄥ':'sheng',
            'ㄖ':'ri','ㄖㄨ':'ru','ㄖㄨㄛ':'ruo','ㄖㄨㄟ':'rui','ㄖㄨㄢ':'ruan','ㄖㄨㄣ':'run','ㄖㄨㄥ':'rong',
            'ㄖㄜ':'re','ㄖㄠ':'rao','ㄖㄡ':'rou','ㄖㄢ':'ran','ㄖㄣ':'ren','ㄖㄤ':'rang','ㄖㄥ':'reng',
            'ㄗ':'zi','ㄗㄨ':'zu','ㄗㄨㄛ':'zuo','ㄗㄨㄟ':'zui','ㄗㄨㄢ':'zuan','ㄗㄨㄣ':'zun','ㄗㄨㄥ':'zong',
            'ㄗㄚ':'za','ㄗㄜ':'ze','ㄗㄞ':'zai','ㄗㄟ':'zei','ㄗㄠ':'zao','ㄗㄡ':'zou','ㄗㄢ':'zan','ㄗㄣ':'zen','ㄗㄤ':'zang','ㄗㄥ':'zeng',
            'ㄘ':'ci','ㄘㄨ':'cu','ㄘㄨㄛ':'cuo','ㄘㄨㄟ':'cui','ㄘㄨㄢ':'cuan','ㄘㄨㄣ':'cun','ㄘㄨㄥ':'cong',
            'ㄘㄚ':'ca','ㄘㄜ':'ce','ㄘㄞ':'cai','ㄘㄠ':'cao','ㄘㄡ':'cou','ㄘㄢ':'can','ㄘㄣ':'cen','ㄘㄤ':'cang','ㄘㄥ':'ceng',
            'ㄙ':'si','ㄙㄨ':'su','ㄙㄨㄛ':'suo','ㄙㄨㄟ':'sui','ㄙㄨㄢ':'suan','ㄙㄨㄣ':'sun','ㄙㄨㄥ':'song',
            'ㄙㄚ':'sa','ㄙㄜ':'se','ㄙㄞ':'sai','ㄙㄠ':'sao','ㄙㄡ':'sou','ㄙㄢ':'san','ㄙㄣ':'sen','ㄙㄤ':'sang','ㄙㄥ':'seng',
            'ㄧ':'yi','ㄧㄚ':'ya','ㄧㄛ':'yo','ㄧㄝ':'ye','ㄧㄞ':'yai','ㄧㄠ':'yao','ㄧㄡ':'you',
            'ㄧㄢ':'yan','ㄧㄣ':'yin','ㄧㄤ':'yang','ㄧㄥ':'ying',
            'ㄨ':'wu','ㄨㄚ':'wa','ㄨㄛ':'wo','ㄨㄞ':'wai','ㄨㄟ':'wei','ㄨㄢ':'wan','ㄨㄣ':'wen','ㄨㄤ':'wang','ㄨㄥ':'weng',
            'ㄩ':'yu','ㄩㄝ':'yue','ㄩㄢ':'yuan','ㄩㄣ':'yun','ㄩㄥ':'yong',
            'ㄚ':'a','ㄜ':'e','ㄞ':'ai','ㄠ':'ao','ㄡ':'ou','ㄢ':'an','ㄣ':'en','ㄤ':'ang','ㄥ':'eng','ㄦ':'er'
        };

        // 反向表：拼音 → 注音陣列（處理一對多，如 nu→[ㄋㄨ,ㄋㄩ]）
        const fullPinyinToZhuyin = {};
        for (const [zy, py] of Object.entries(fullZhuyinToPinyin)) {
            if (!fullPinyinToZhuyin[py]) fullPinyinToZhuyin[py] = [];
            if (!fullPinyinToZhuyin[py].includes(zy)) fullPinyinToZhuyin[py].push(zy);
        }

        // 拼音聲母 → 注音聲母（保留，用於聲母偵測）
        const pinyinInitialToZhuyin = {
            'b': 'ㄅ', 'p': 'ㄆ', 'm': 'ㄇ', 'f': 'ㄈ',
            'd': 'ㄉ', 't': 'ㄊ', 'n': 'ㄋ', 'l': 'ㄌ',
            'g': 'ㄍ', 'k': 'ㄎ', 'h': 'ㄏ',
            'j': 'ㄐ', 'q': 'ㄑ', 'x': 'ㄒ',
            'zh': 'ㄓ', 'ch': 'ㄔ', 'sh': 'ㄕ', 'r': 'ㄖ',
            'z': 'ㄗ', 'c': 'ㄘ', 's': 'ㄙ'
        };

        // ==================== 借韻表（附件一 §II）====================
        // 搜尋左側韻母時，同時匹配右側所有韻母（單向展開）
        // 每個韻母獨立成一個顏色群組，在同聲韻並列時分色顯示
        const BORROW_MAP = {
            'ㄧ':   ['ㄧ'],
            'ㄨ':   ['ㄨ'],
            'ㄩ':   ['ㄩ'],
            'ㄚ':   ['ㄚ', 'ㄧㄚ', 'ㄨㄚ'],
            'ㄛ':   ['ㄛ', 'ㄡ', 'ㄧㄛ', 'ㄧㄡ', 'ㄨㄛ'],
            'ㄜ':   ['ㄜ', 'ㄦ'],
            'ㄝ':   ['ㄝ', 'ㄟ', 'ㄧㄝ', 'ㄩㄝ', 'ㄨㄟ'],
            'ㄞ':   ['ㄞ', 'ㄧㄞ', 'ㄨㄞ'],
            'ㄟ':   ['ㄟ', 'ㄝ', 'ㄨㄟ', 'ㄧㄝ', 'ㄩㄝ'],
            'ㄠ':   ['ㄠ', 'ㄧㄠ'],
            'ㄡ':   ['ㄡ', 'ㄛ', 'ㄧㄛ', 'ㄧㄡ', 'ㄨㄛ'],
            'ㄢ':   ['ㄢ', 'ㄨㄢ'],
            'ㄣ':   ['ㄣ', 'ㄨㄣ', 'ㄥ'],
            'ㄤ':   ['ㄤ', 'ㄧㄤ', 'ㄨㄤ'],
            'ㄥ':   ['ㄥ', 'ㄣ'],
            'ㄦ':   ['ㄦ', 'ㄜ'],
            'ㄩㄢ': ['ㄩㄢ', 'ㄧㄢ'],
            'ㄧㄢ': ['ㄧㄢ', 'ㄩㄢ'],
            'ㄧㄣ': ['ㄧㄣ', 'ㄧㄥ', 'ㄩㄣ'],
            'ㄧㄥ': ['ㄧㄥ', 'ㄧㄣ', 'ㄩㄣ'],
            'ㄨㄥ': ['ㄨㄥ', 'ㄩㄥ'],
            'ㄩㄥ': ['ㄩㄥ', 'ㄨㄥ'],
        };

        // 韻母家族（子音搜尋 + 同聲韻並列時，同一家族共用顏色）
        const RHYME_FAMILIES = [
            { id: 0,  label: 'ㄧ',    rhymes: new Set(['ㄧ']) },
            { id: 1,  label: 'ㄨ',    rhymes: new Set(['ㄨ']) },
            { id: 2,  label: 'ㄩ',    rhymes: new Set(['ㄩ']) },
            { id: 3,  label: 'ㄚ',    rhymes: new Set(['ㄚ', 'ㄧㄚ', 'ㄨㄚ']) },
