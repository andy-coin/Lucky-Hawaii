{
  "name": "lucky-hawaii",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "perf": "LH_PERF=1 playwright test tests/perf.spec.mjs --workers=1",
    "perf:record": "LH_PERF=record playwright test tests/perf.spec.mjs --workers=1",
    "golden:update": "UPDATE_GOLDEN=1 playwright test tests/golden.spec.mjs",
    "visual:update": "playwright test tests/visual.spec.mjs --update-snapshots",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --var ALLOW_LOCAL_ORIGIN:1",
    "worker:check": "wrangler deploy --dry-run --outdir worker/.wrangler/dryrun --config worker/wrangler.toml",
    "worker:deploy": "node worker/check-ids.mjs && wrangler deploy --config worker/wrangler.toml",
    "worker:smoke": "node worker/test/dev-smoke.mjs",
    "lexicon:build": "python3 -B tools/lexicon/build.py all",
    "lexicon:verify": "python3 -B tools/lexicon/build.py verify",
    "lexicon:eval": "python3 -B tools/lexicon/build.py eval",
    "lexicon:judge": "python3 -B tools/lexicon/build.py judge --rebuild",
    "lexicon:slang": "python3 -B tools/lexicon/slang.py",
    "lexicon:test": "python3 -B -m unittest discover -s tools/lexicon/tests -t tools/lexicon",
    "corrections:writeback": "python3 -B tools/corrections/writeback.py",
    "corrections:test": "python3 -B -m unittest discover -s tools/corrections/tests -t tools/corrections"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "acorn": "8.18.0",
    "wrangler": "4.147.0"
  }
}
